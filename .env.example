# 复制为 .env 后修改。生产环境务必修改所有密码与 JWT_SECRET
DB_PASSWORD=zupu_dev_pw
JWT_SECRET=please-change-this-secret
WEB_PORT=8080

# 媒体存储：local（默认，存 Docker 卷）| s3（S3 兼容：腾讯云 COS / 阿里云 OSS / MinIO）
STORAGE_DRIVER=local
# 浏览器可直连的地址（COS/OSS 可填 endpoint 或 CDN 域名）；留空则由 API 代理读取并校验签名
S3_PUBLIC_ENDPOINT=
# 腾讯云 COS 示例：
#   S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
#   S3_REGION=ap-guangzhou
#   S3_BUCKET=zupu-1250000000
#   S3_FORCE_PATH_STYLE=false
# 阿里云 OSS 示例：
#   S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#   S3_REGION=oss-cn-hangzhou
#   S3_BUCKET=zupu
#   S3_FORCE_PATH_STYLE=false
S3_AUTO_CREATE_BUCKET=false
S3_ACCESS_KEY=zupu
S3_SECRET_KEY=zupu_minio_pw
